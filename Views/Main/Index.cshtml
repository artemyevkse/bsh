@{Layout = "/Views/Shared/Layout.cshtml";}
@model List<Part>


<form method='post' action='/findPart/'>
	Code: <input name='code' type='text' value='10026022'>
	<input name='run' value='Find' type='submit'>
</form>

<hr class="hr-shadow">

<center>
	@if(Model.Count > 0)
	{
		<table class='table'>
			<thead><tr><th>#</th><th>Part</th><th>Update time</th><th>Items count</th><th>Model list file</th>
				<th>Actions</th>
			</tr></thead>
			<tbody>
			@foreach((int index, Part item) in Model.Index())
			{
				<tr>
					<td>@(index+1)</td>
					<td>@item.code</td>
					<td>@item.date</td>
					<td>@item.items</td>
					<td>
						@if(item.xlsxExists)
						{
							<a target='_blank' href='/files/@(item.code).xlsx'>@(item.code).xlsx</a> @:(local storage)
						} else
						{
							<a target='_blank' href='@(ViewBag.onlineHost)/bsh/get-part-xlsx/@(item.code).xlsx'>@(item.code).xlsx</a>
						}
					</td>
					<td><a href='/deletePart/@(item.id)'><img class='icon delete'/></a></td>
				</tr>
			}
			</tbody>
		</table>
	}
</center>