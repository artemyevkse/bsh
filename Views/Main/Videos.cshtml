@{Layout = "/Views/Shared/Layout.cshtml";}
@model List<Video>


Links to videos

<hr class="hr-shadow">

<center>
	@if(Model.Count > 0)
	{
		<table class='table'>
			<thead><tr><th>#</th><th>Model</th><th>Name</th><th>Url</th><th>Description</th>
				<th>Update time</th>
			</tr></thead>
			<tbody>
			@foreach((int index, Video item) in Model.Index())
			{
				<tr>
					<td>@(index+1)</td>
					<td>@item.model</td>
					<td>@item.name</td>
					<td><a target='_blank' href='@item.url'>@item.videoId</a></td>
					<td>@item.description</td>
					<td>@item.date</td>
				</tr>
			}
			</tbody>
		</table>
	}
</center>